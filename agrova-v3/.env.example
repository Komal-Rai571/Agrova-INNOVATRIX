# Set before running: GEMINI_API_KEY=... npm start
# Optional. Without this, manual verification and offline text parsing still work.
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# For production: require HTTPS and set NODE_ENV=production
NODE_ENV=development

# V3.1: optional real account verification emails via Resend HTTPS API.
# In NODE_ENV=development, with no Resend key, verification links are printed
# to the server console for local testing. NO EMAIL is sent in that mode.
PUBLIC_BASE_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=
